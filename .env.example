# Load with: python -m uvicorn backend.app.main:app --env-file .env
# Paths are expanded locally. Source files are read-only.
LENTICA_DOCUMENTS_SOURCE=./library/documents
LENTICA_PHOTOS_SOURCE=./library/photos
LENTICA_DATA_DIR=./data

# Queue settings persist in data/queue_settings.json after first start.
# This example starts with CPU smoke mode; hashes are NOT semantic embeddings.
LENTICA_QUEUE_ENABLED=true
LENTICA_WORKER_MODE=smoke
LENTICA_ENABLE_FACES=false

# For semantic photos: install .[models], provision model caches, set mode=gpu.
LENTICA_VISION_ENDPOINT=http://127.0.0.1:8100
LENTICA_VISION_MODEL=qwen-vl-photo-context
LENTICA_QWEN_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
LENTICA_CLIP_MODEL=openai/clip-vit-base-patch32
LENTICA_TEXT_MODEL=BAAI/bge-m3
# LENTICA_WORKER_PYTHON=/absolute/path/to/python
